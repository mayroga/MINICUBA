        },
        {
          "t": "d",
          "q": {"en": "If you feel angry, what is the smartest first step?"},
          "op": [
            "Act instantly",
            "Shout",
            "Leave without thinking",
            "Stop and observe the feeling"
          ],
          "c": 3,
          "ex": [
            "Instant action = impulsivity",
            "Shouting = escalation",
            "Leaving without thinking = avoidance",
            "Observation = awareness and control"
          ]
        },
        {"t": "r", "tx": "+Control", "p": 25},
        {
          "t": "sil",
          "d": 40,
          "tx": {"en": "Watch the emotion without responding to it"},
          "inf": {"en": "Strengthens emotional separation between feeling and action"}
        },
        {
          "t": "breath_auto",
          "d": 25,
          "tx": {"en": "Inhale stability... exhale impulsiveness"},
          "inf": {"en": "This regulates nervous system reactivity and improves decision timing"}
