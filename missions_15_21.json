          "d": 25,
          "tx": {"en": "Breathe slowly to stabilize your emotional state"},
          "inf": {"en": "This breathing reduces amygdala reactivity and increases self-control before action"}
        },
        {
          "t": "d",
          "q": {"en": "What creates real emotional control?"},
          "op": [
            "React immediately",
            "Suppress feelings completely",
            "Pause and breathe before acting",
            "Escalate response"
          ],
          "c": 2,
          "ex": [
